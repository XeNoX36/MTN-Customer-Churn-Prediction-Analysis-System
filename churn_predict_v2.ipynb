"""
train_churn.py — MTN churn model training (v2 consolidated)

Produces:
    churn_model_bundle.pkl   -> consumed by churn_app.py
    model_report.txt         -> plain-text leaderboard + final metrics

Run:
    python train_churn.py
"""
import json
from pathlib import Path

import joblib
import numpy as np
import pandas as pd

from sklearn.calibration import CalibratedClassifierCV
from sklearn.compose import ColumnTransformer
from sklearn.ensemble import (
    GradientBoostingClassifier, HistGradientBoostingClassifier,
    RandomForestClassifier, StackingClassifier,
)
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    accuracy_score, average_precision_score, classification_report,
    confusion_matrix, precision_recall_curve, roc_auc_score,
)
from sklearn.model_selection import (
    GridSearchCV, StratifiedKFold, cross_val_score, train_test_split,
)
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler

# ─────────────────────────────────────────────────────────────
# Config
# ─────────────────────────────────────────────────────────────
DATA_PATH    = Path(r"c:\Users\HomePC\Documents\Repository\MTN\new_mtn.csv")
BUNDLE_PATH  = Path("churn_model_bundle.pkl")
REPORT_PATH  = Path("model_report.txt")
RANDOM_STATE = 42
np.random.seed(RANDOM_STATE)

# ─────────────────────────────────────────────────────────────
# 1. Load + aggregate to one row per customer
# ─────────────────────────────────────────────────────────────
df = pd.read_csv(DATA_PATH)
df["Reasons for Churn"] = df["Reasons for Churn"].fillna("")

agg = {
    "Age":                        "first",
    "Gender":                     "first",
    "State":                      "first",
    "Satisfaction Rate":          "mean",
    "Customer Tenure in months":  "mean",
    "Total Revenue":              "sum",
    "Unit Price":                 "mean",
    "Data Usage":                 "mean",
    "Number of Times Purchased":  "sum",
    "MTN Device":                 lambda s: s.mode().iat[0],
    "Subscription Plan":          lambda s: s.mode().iat[0],
    "Customer Churn Status":      "first",
    "Reasons for Churn":          "first",
}
cust = df.groupby("Customer ID").agg(agg).reset_index()
cust["Churn"] = (cust["Customer Churn Status"] == "Yes").astype(int)

# ─────────────────────────────────────────────────────────────
# 2. Feature engineering
# ─────────────────────────────────────────────────────────────
cust["Spend_per_Month"]      = cust["Total Revenue"] / cust["Customer Tenure in months"].clip(lower=1)
cust["Data_per_Purchase"]    = cust["Data Usage"] / cust["Number of Times Purchased"].clip(lower=1)
cust["Revenue_per_Purchase"] = cust["Total Revenue"] / cust["Number of Times Purchased"].clip(lower=1)
cust["High_Satisfaction"]    = (cust["Satisfaction Rate"] >= 4).astype(int)
cust["Is_Long_Tenure"]       = (cust["Customer Tenure in months"] >= 36).astype(int)

cust = cust.drop(columns=["Customer ID", "Customer Churn Status", "Reasons for Churn"])
y = cust["Churn"]
X = cust.drop(columns=["Churn"])

# ─────────────────────────────────────────────────────────────
# 3. Preprocessing pipeline
# ─────────────────────────────────────────────────────────────
num_cols = [
    "Age", "Satisfaction Rate", "Customer Tenure in months", "Total Revenue",
    "Unit Price", "Data Usage", "Number of Times Purchased",
    "Spend_per_Month", "Data_per_Purchase", "Revenue_per_Purchase",
]
cat_cols = ["Gender", "State", "MTN Device", "Subscription Plan"]
bin_cols = ["High_Satisfaction", "Is_Long_Tenure"]

preprocess = ColumnTransformer([
    ("num", Pipeline([
        ("impute", SimpleImputer(strategy="median")),
        ("scale",  StandardScaler()),
    ]), num_cols),
    ("cat", Pipeline([
        ("impute", SimpleImputer(strategy="most_frequent")),
        ("onehot", OneHotEncoder(handle_unknown="ignore", sparse_output=False)),
    ]), cat_cols),
    ("bin", SimpleImputer(strategy="most_frequent"), bin_cols),
])

# ─────────────────────────────────────────────────────────────
# 4. Split
# ─────────────────────────────────────────────────────────────
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=RANDOM_STATE,
)
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)

# ─────────────────────────────────────────────────────────────
# 5. Model leaderboard
# ─────────────────────────────────────────────────────────────
models = {
    "Logistic Regression": LogisticRegression(
        max_iter=2000, class_weight="balanced", random_state=RANDOM_STATE),
    "Random Forest": RandomForestClassifier(
        n_estimators=400, min_samples_leaf=2, class_weight="balanced",
        n_jobs=-1, random_state=RANDOM_STATE),
    "HistGradientBoosting": HistGradientBoostingClassifier(
        max_iter=400, learning_rate=0.06, l2_regularization=0.5,
        random_state=RANDOM_STATE),
    "GradientBoosting": GradientBoostingClassifier(
        n_estimators=300, learning_rate=0.05, max_depth=3,
        random_state=RANDOM_STATE),
}

print("─" * 60)
print("STEP 1 — cross-validated ROC-AUC per model")
print("─" * 60)
for name, clf in models.items():
    pipe = Pipeline([("prep", preprocess), ("clf", clf)])
    auc = cross_val_score(pipe, X_train, y_train, cv=cv,
                          scoring="roc_auc", n_jobs=-1)
    print(f"{name:24s} AUC = {auc.mean():.4f} ± {auc.std():.4f}")

# Stacked ensemble of the two strongest families
stack = StackingClassifier(
    estimators=[
        ("rf",  models["Random Forest"]),
        ("hgb", models["HistGradientBoosting"]),
    ],
    final_estimator=LogisticRegression(max_iter=2000, class_weight="balanced"),
    n_jobs=-1, cv=5,
)
stack_pipe = Pipeline([("prep", preprocess), ("clf", stack)])
stack_auc = cross_val_score(stack_pipe, X_train, y_train, cv=cv,
                            scoring="roc_auc", n_jobs=-1)
print(f"{'Stacked Ensemble':24s} AUC = {stack_auc.mean():.4f} ± {stack_auc.std():.4f}")

# ─────────────────────────────────────────────────────────────
# 6. Tune the best base model (Random Forest)
# ─────────────────────────────────────────────────────────────
print("\nSTEP 2 — tuning Random Forest")
rf_pipe = Pipeline([
    ("prep", preprocess),
    ("clf",  RandomForestClassifier(
        class_weight="balanced", n_jobs=-1, random_state=RANDOM_STATE)),
])
grid = GridSearchCV(rf_pipe, {
    "clf__n_estimators":     [300, 500, 800],
    "clf__max_depth":        [None, 12, 20],
    "clf__min_samples_leaf": [1, 2, 4],
}, cv=cv, scoring="roc_auc", n_jobs=-1)
grid.fit(X_train, y_train)
print("Best params:", grid.best_params_)
print(f"Best CV AUC: {grid.best_score_:.4f}")
best_pipe = grid.best_estimator_

# ─────────────────────────────────────────────────────────────
# 7. Calibrate
# ─────────────────────────────────────────────────────────────
print("\nSTEP 3 — calibrating probabilities")
calibrated = CalibratedClassifierCV(best_pipe, method="isotonic", cv=5)
calibrated.fit(X_train, y_train)

# ─────────────────────────────────────────────────────────────
# 8. Threshold tuning + test set metrics
# ─────────────────────────────────────────────────────────────
probs = calibrated.predict_proba(X_test)[:, 1]
prec, rec, thr = precision_recall_curve(y_test, probs)
f1 = 2 * prec * rec / (prec + rec + 1e-9)
best_thr = float(thr[np.argmax(f1)])
y_pred = (probs >= best_thr).astype(int)

report = {
    "threshold":  best_thr,
    "roc_auc":    float(roc_auc_score(y_test, probs)),
    "pr_auc":     float(average_precision_score(y_test, probs)),
    "accuracy":   float(accuracy_score(y_test, y_pred)),
    "confusion":  confusion_matrix(y_test, y_pred).tolist(),
    "class_report": classification_report(y_test, y_pred,
                                          target_names=["No Churn", "Churn"],
                                          output_dict=True),
}

print("\n" + "═" * 60)
print("STEP 4 — FINAL TEST SET METRICS")
print("═" * 60)
print(f"Decision threshold : {best_thr:.3f}")
print(f"ROC-AUC           : {report['roc_auc']:.4f}")
print(f"PR-AUC            : {report['pr_auc']:.4f}")
print(f"Accuracy          : {report['accuracy']:.4f}")
print("\nClassification report:")
print(classification_report(y_test, y_pred, target_names=["No Churn", "Churn"]))
print("Confusion matrix (rows=true, cols=pred):")
print(np.array(report["confusion"]))

# ─────────────────────────────────────────────────────────────
# 9. Feature importances
# ─────────────────────────────────────────────────────────────
inner_pipe = calibrated.calibrated_classifiers_[0].estimator
rf = inner_pipe.named_steps["clf"]
feat_names = inner_pipe.named_steps["prep"].get_feature_names_out()
top_imp = (pd.Series(rf.feature_importances_, index=feat_names)
             .sort_values(ascending=False).head(10))

print("\nTop 10 churn drivers:")
for feat, score in top_imp.items():
    print(f"  {feat:40s} {score:.4f}")

# ─────────────────────────────────────────────────────────────
# 10. Save bundle + report
# ─────────────────────────────────────────────────────────────
bundle = {
    "pipeline": calibrated,
    "threshold": best_thr,
    "feature_columns": X.columns.tolist(),
    "numeric_columns": num_cols,
    "categorical_columns": cat_cols,
    "binary_columns": bin_cols,
    "top_importances": {str(k): float(v) for k, v in top_imp.items()},
    "metrics": {"roc_auc": report["roc_auc"], "accuracy": report["accuracy"]},
}
joblib.dump(bundle, BUNDLE_PATH)
REPORT_PATH.write_text(json.dumps(report, indent=2, default=float))
print(f"\n✅ Saved {BUNDLE_PATH.resolve()}")
print(f"✅ Saved {REPORT_PATH.resolve()}")